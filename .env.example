# Database
DATABASE_URL=postgresql+asyncpg://golden_hour:changeme@localhost:5432/golden_hour
POSTGRES_USER=golden_hour
POSTGRES_PASSWORD=changeme
POSTGRES_DB=golden_hour

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_to_a_random_256_bit_secret_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# SMS / Alerts
SMS_PROVIDER_API_KEY=your_twilio_or_africas_talking_api_key
SMS_PROVIDER=twilio
ALERT_PHONE_NUMBER=+91XXXXXXXXXX
DISTRICT_OFFICER_PHONE=+91XXXXXXXXXX

# Push Notifications (Firebase)
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FCM_PROJECT_ID=your_firebase_project_id

# Dashboard
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Monitoring
ADMIN_PHONE=+91XXXXXXXXXX
NTFY_TOPIC=golden-hour-alerts

# ML (optional stretch goal)
ML_MODEL_PATH=packages/ml/models/deterioration_model.onnx
ML_ENABLED=false
