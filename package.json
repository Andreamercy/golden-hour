{
  "name": "golden-hour",
  "version": "1.0.0",
  "private": true,
  "description": "Health Early Warning System — offline-first clinical decision support",
  "scripts": {
    "dev": "docker-compose up -d && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "setup": "pnpm install && docker-compose pull",
    "db:migrate": "cd packages/api && alembic upgrade head",
    "db:seed": "tsx scripts/seed-db.ts",
    "generate:mock": "tsx scripts/generate-mock-data.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
